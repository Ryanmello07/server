# URnetwork beta environment variables
# Docker Compose does not use this file directly; values are inlined in docker-compose.beta.yml.
# Copy to .env and adjust if you run binaries outside Docker.
WARP_ENV=local
WARP_BLOCK=local
WARP_VERSION=0.0.0-beta
WARP_HOST=127.0.0.1
BRINGYOUR_POSTGRES_HOSTNAME=postgres
BRINGYOUR_REDIS_HOSTNAME=redis
WARP_HOME=/srv/warp
