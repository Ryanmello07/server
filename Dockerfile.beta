# syntax=docker/dockerfile:1
# Beta self-contained build for URnetwork server + connect + bringyourctl.
# Build context must be the urnetwork parent directory so sibling modules can be copied.

# The image's Go must be at least the `go` line of go.mod (1.27.2 since the
# 2026-10-09 upstream merge). The golang images set GOTOOLCHAIN=local, so an
# older one refuses to build instead of fetching the toolchain go.mod names.
FROM golang:1.27.2-bookworm AS build

# Layout inside the builder image mirrors the local urnetwork monorepo.
WORKDIR /workspace
COPY ./server /workspace/server
COPY ./connect /workspace/connect
COPY ./proxy /workspace/proxy
COPY ./sdk /workspace/sdk
COPY ./glog /workspace/glog
COPY ./userwireguard /workspace/userwireguard
COPY ./sn /workspace/sn
# required since the upstream merge: go.mod replaces goidenticons with ../goidenticons
COPY ./goidenticons /workspace/goidenticons
# required since the 2026-10-06 upstream merge: go.mod replaces gvisor.dev/gvisor
# with ../gvisor (the urnetwork fork, branch `go`). That merge also dropped the
# operator-proxy and warp replaces -- nothing imports either any more -- so
# they are no longer copied.
#
# Upstream removed .github/workflows/test.yml on 2026-10-06, and the sibling
# pins it carried went with it. local/source-graph/lock.yml remains but lags:
# at upstream 866080aa it still names the 2026-10-06 revisions and Go 1.26.7.
# Each beta sync therefore records the sibling revisions it built and tested
# against in its merge commit message.
COPY ./gvisor /workspace/gvisor

WORKDIR /workspace/server
# Build only the binaries the beta stack runs, not ./... . Beta ships these
# four; building the rest (connect/sim-latency, monitor, scripts) only makes
# the image larger and lets breakage in a tool beta never runs block a deploy.
# -mod=readonly, not `go mod tidy`: build exactly the go.mod/go.sum upstream
# tested, so the image cannot silently resolve a different dependency set.
RUN CGO_ENABLED=0 GOFLAGS=-mod=readonly go build -o /out/ \
    ./bringyourctl ./cli/api ./cli/connect ./cli/taskworker ./cli/proxy

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /out/* /app/
COPY --from=build /workspace/server/beta-entrypoint.sh /app/beta-entrypoint.sh
RUN chmod +x /app/beta-entrypoint.sh

ENTRYPOINT ["/app/beta-entrypoint.sh"]
