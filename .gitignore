# Beta environment generated secrets and databases
beta-vault/config/**/*.mmdb
beta-vault/vault/tls/**/*.pem
beta-vault/vault/tls/**/*.pub.pem
# caddy writes .crt/.key, not .pem. Without these two lines the proxy's
# TLS PRIVATE KEY is untracked-but-not-ignored, so a `git add -A` commits it.
beta-vault/vault/tls/**/*.key
beta-vault/vault/tls/**/*.crt
beta-vault/beta-secrets.env
# egress-prober client jwt and operator secret; the .example template is tracked
beta-vault/prober.env
beta-vault/vault/*.yml
# Keep .example templates tracked
!beta-vault/vault/*.yml.example
plans/
.superpowers/

# local beta database dumps (contain user data; never commit)
beta-backups/
# binaries
client/build
bringyourctl/bringyourctl
cli/api/api
cli/mcp/mcp
cli/taskworker/taskworker
gpt/gpt
cli/connect/connect
connect/connect.test
connect/profile
cli/proxy/proxy
main
connect/sim-latency/sim-latency

# DKIM signing keys for the beta mail server (private key must never be committed)
beta-vault/dkim/

# go test binaries and profiles -- build artifacts, never committed
*.test
model/profile/
