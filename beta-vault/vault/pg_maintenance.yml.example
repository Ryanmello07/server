# Example beta vault config. This file is generated by ./beta-setup.sh into
# beta-vault/vault/pg_maintenance.yml with the same values as pg.yml.
#
# The server requires it: database ownership (the task queue, settlement and
# balance debits) runs on a direct postgres session and refuses to start
# without an explicit route to it. Upstream points pg.yml at a pooler and this
# file at postgres itself; beta has no pooler, so both name the same server.
authority: "postgres:5432"
user: "postgres"
password: "<GENERATED_BY_BETA_SETUP_SH>"
db: "postgres"
